# Postgres (Render, Supabase…). Без ове линије сервер диже уграђени PGlite у
# server/.data/pglite — за локални рад не треба ништа инсталирати.
# DATABASE_URL=postgresql://korisnik:lozinka@host:5432/baza

# Тајна за потписивање пријаве. Обавезна у продукцији; промена одјављује све.
SESSION_SECRET=promeni-me-u-dugacak-nasumican-niz

# Први админ налог — користи га само `npm run seed` (постојећи налог не дира).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=promeni-me-najmanje-8

# Префикс псеудонима у извозу; свака инсталација свој, да се скупови не сударе.
RESEARCH_ID_PREFIX=IS

# Порт сервера (клијент у развоју прослеђује /api на 3001).
PORT=3001
