# Postgres — Render, Supabase или локални сервер.
# За Supabase узми Session pooler string; ако веза буде одбијена, додај
# ?sslmode=require на крај.
DATABASE_URL=postgresql://korisnik:lozinka@localhost:5432/istorija_mala_matura

# Тајна за потписивање токена. Промена одјављује све кориснике.
SESSION_SECRET=promeni-me-u-dugacak-nasumican-niz

# Порт сервера и основна путања фронтенда
PORT=5000
BASE_PATH=/

# Само за скрипту seed (и probni-prolaz, који се пријављује као админ)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=promeni-me
