{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "verify:scoring": "tsx scripts/verify-scoring.ts",
    "verify:exams": "tsx scripts/verify-exams.ts",
    "verify:study": "tsx scripts/verify-study.ts",
    "verify:tekst": "tsx scripts/verify-tekst.ts",
    "migrate": "tsx scripts/migrate.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "backup": "tsx scripts/backup.ts",
    "probni-prolaz": "tsx scripts/probni-prolaz.ts"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
